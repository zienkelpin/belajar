<script>
const answers={q1:"b",q2:"a",q3:"c",q4:"b",q5:"a",q6:"b",q7:"c",q8:"a",q9:"d",q10:"b"};
const explanations={
q1:"Interaksi merupakan hubungan timbal balik yang melibatkan tanggapan.",
q2:"Syarat utama interaksi sosial adalah kontak sosial dan komunikasi.",
q3:"Pesan melalui telepon merupakan kontak tidak langsung.",
q4:"Membersihkan kelas bersama adalah kerja sama.",
q5:"Akomodasi merupakan usaha meredakan atau menyelesaikan pertentangan.",
q6:"Persaingan termasuk proses disosiatif.",
q7:"Asimilasi adalah pembauran budaya yang menghasilkan budaya baru.",
q8:"Tanya jawab merupakan komunikasi karena ada pesan dan tanggapan.",
q9:"Konflik merupakan pertentangan yang terjadi secara terbuka.",
q10:"Diskusi dalam grup kelas daring adalah interaksi melalui media digital."
};
function checkAnswers(){
 let score=0,unanswered=0,details="";
 for(let i=1;i<=10;i++){
  const key="q"+i,selected=document.querySelector('input[name="'+key+'"]:checked');
  if(!selected)unanswered++;
  const good=selected&&selected.value===answers[key];
  if(good)score++;
  details+='<div class="feedback '+(good?'correct':'incorrect')+'"><b>Nomor '+i+': '+(good?'Benar':'Belum tepat')+'.</b> '+explanations[key]+'</div>';
 }
 const box=document.getElementById("result");box.style.display="block";
 box.innerHTML='<h3>Nilai kamu: '+(score*10)+'/100</h3><p>Jawaban benar: '+score+' dari 10.'+(unanswered?' Belum dijawab: '+unanswered+'.':' Semua soal sudah dijawab.')+'</p>'+details;
 box.scrollIntoView({behavior:"smooth",block:"start"});
}
function resetQuiz(){const box=document.getElementById("result");box.style.display="none";box.innerHTML="";}
</script>
